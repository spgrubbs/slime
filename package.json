{
  "name": "hive-queen",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "node --test src/combat/*.test.js",
    "icons": "node scripts/generate-icons.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npm run android:sync && npx cap open android"
  },
  "browserslist": [
    ">0.2%",
    "not dead"
  ],
  "type": "module",
  "devDependencies": {
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20"
  }
}
